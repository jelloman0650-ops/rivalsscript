local function safeListen(remote)
	if remote and remote:IsA("RemoteEvent") then
		pcall(function()
			remote.OnClientEvent:Connect(function() end)
		end)
	end

	if remote and remote:IsA("UnreliableRemoteEvent") then
		pcall(function()
			remote.OnClientEvent:Connect(function() end)
		end)
	end
end

