local function hasDangerAttribute(inst)
	for _, attrName in ipairs(HAZARD_ATTRIBUTES) do
		local ok, value = pcall(function()
			return inst:GetAttribute(attrName)
		end)

		if ok then
			if value == true then
				return true
			end

			if type(value) == "number" and value > 0 then
				return true
			end

			if type(value) == "string" then
				local lowered = lowerText(value)
				if lowered ~= "" and lowered ~= "false" and lowered ~= "0" and lowered ~= "none" then
					return true
				end
			end
		end
	end

	return false
end

local function hasDangerTag(inst)
	for _, tagName in ipairs(HAZARD_TAGS) do
		local ok, tagged = pcall(function()
			return CollectionService:HasTag(inst, tagName)
		end)

		if ok and tagged then
			return true
		end
	end

	return false
end

local function isDangerPart(inst)
	local current = inst

	while current and current ~= workspace do
		if hasKeyword(current.Name, HAZARD_KEYWORDS) then
			return true
		end

		if hasDangerAttribute(current) then
			return true
		end

		if hasDangerTag(current) then
			return true
		end

		current = current.Parent
	end

	return false
end

local function makeRayParams(myChar, enemyChar)
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.IgnoreWater = true

	local exclude = {}
	if myChar then table.insert(exclude, myChar) end
	if enemyChar then table.insert(exclude, enemyChar) end
	rayParams.FilterDescendantsInstances = exclude

	return rayParams
end

local function makeOverlapParams(myChar, enemyChar)
	local overlapParams = OverlapParams.new()
	overlapParams.FilterType = Enum.RaycastFilterType.Exclude

	local exclude = {}
	if myChar then table.insert(exclude, myChar) end
	if enemyChar then table.insert(exclude, enemyChar) end
	overlapParams.FilterDescendantsInstances = exclude

	return overlapParams
end

local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

local function safeUnit(v, fallback)
	if v.Magnitude > 0.01 then
		return v.Unit
	end
	return fallback
end

local function findGroundedPosition(pos, myChar, enemyChar)
	local rayStart = pos + Vector3.new(0, 12, 0)
	local rayDirection = Vector3.new(0, -260, 0)
	local hit = workspace:Raycast(rayStart, rayDirection, makeRayParams(myChar, enemyChar))

	if hit and hit.Instance then
		if isDangerPart(hit.Instance) then
			return nil, "ground is kill part: " .. hit.Instance.Name
		end

		if hit.Instance:IsA("BasePart") and hit.Instance.CanCollide == false then
			return nil, "ground is non-collide: " .. hit.Instance.Name
		end

		return Vector3.new(pos.X, hit.Position.Y + 3.4, pos.Z), nil
	end

	-- Do not block retreat just because no ray hit. Some maps have custom floors/streaming.
	return pos, "no ground ray hit, using raw retreat position"
end

local function nearDangerPart(pos, myChar, enemyChar)
	local scanRadius = 6
	local scanSize = Vector3.new(scanRadius, 8, scanRadius)

	local ok, parts = pcall(function()
		return workspace:GetPartBoundsInBox(CFrame.new(pos), scanSize, makeOverlapParams(myChar, enemyChar))
	end)

	if not ok or not parts then
		return false
	end

	for _, part in ipairs(parts) do
		if part:IsA("BasePart") and isDangerPart(part) then
			ORBIT_DANGER_REASON = "near kill part: " .. part.Name
			return true
		end
	end

	return false
end

local function validCandidate(pos, enemyRoot, myChar, enemyChar, mode)
	local grounded, groundReason = findGroundedPosition(pos, myChar, enemyChar)
	if not grounded then
		ORBIT_DANGER_REASON = groundReason or "bad ground"
		return nil
	end

	local fallenHeight = workspace.FallenPartsDestroyHeight or -500
	if grounded.Y <= fallenHeight + followSetting("ORBIT_EXTRA_VOID_BUFFER", 70) then
		ORBIT_DANGER_REASON = "too close to void"
		return nil
	end

	if nearDangerPart(grounded, myChar, enemyChar) then
		return nil
	end

	-- For retreat, prefer being behind or side-back, never the enemy's front.
	if mode == "RETREAT" then
		local enemyFlatLook = safeUnit(flat(enemyRoot.CFrame.LookVector), Vector3.new(0, 0, -1))
		local dirFromEnemy = flat(grounded - enemyRoot.Position)

		if dirFromEnemy.Magnitude > 0.01 then
			local frontDot = dirFromEnemy.Unit:Dot(enemyFlatLook)
			if frontDot > 0.05 then
				ORBIT_DANGER_REASON = "candidate was in enemy front"
				return nil
			end
		end
	end

	return grounded
end

local function buildPositions(enemyRoot, myRoot, mode)
	local center = enemyRoot.Position
	local back = safeUnit(-flat(enemyRoot.CFrame.LookVector), Vector3.new(0, 0, 1))
	local right = safeUnit(flat(enemyRoot.CFrame.RightVector), Vector3.new(1, 0, 0))

	local away = back
	if myRoot then
		away = safeUnit(flat(myRoot.Position - enemyRoot.Position), back)
	end

	if mode == "RETREAT" then
		local distance = followSetting("FOLLOW_MELEE_SAFE_DISTANCE", 17)
		local height = followSetting("FOLLOW_MELEE_SAFE_HEIGHT", 5.5)
		local side = followSetting("FOLLOW_SIDE_STEP", 8)
		local up = Vector3.new(0, height, 0)

		return {
			center + back * distance + up,
			center + back * (distance + 8) + up,
			center + back * distance + right * side + up,
			center + back * distance - right * side + up,
			center + back * (distance + 12) + right * (side * 0.75) + up,
			center + back * (distance + 12) - right * (side * 0.75) + up,
			center + away * math.max(distance + 5, 22) + up,
		}
	end

	if mode == "PULSE" then
		local distance = followSetting("FOLLOW_MELEE_ATTACK_DISTANCE", 4.25)
		local height = followSetting("FOLLOW_MELEE_ATTACK_HEIGHT", 3.25)
		local up = Vector3.new(0, height, 0)

		return {
			center + back * distance + up,
			center + back * (distance + 1.5) + up,
			center + back * distance + right * 1.5 + up,
			center + back * distance - right * 1.5 + up,
		}
	end

	local normalDistance = followSetting("FOLLOW_BEHIND_DISTANCE", 4.5)
	local normalHeight = followSetting("FOLLOW_BEHIND_HEIGHT", 3.25)
	local up = Vector3.new(0, normalHeight, 0)

	return {
		center + back * normalDistance + up,
		center + back * (normalDistance + 1.5) + up,
		center + back * normalDistance + right * 1.25 + up,
		center + back * normalDistance - right * 1.25 + up,
	}
end

local function pickPosition(enemyRoot, myRoot, myChar, enemyChar, mode)
	local candidates = buildPositions(enemyRoot, myRoot, mode)

	for _, rawPos in ipairs(candidates) do
		local pos = validCandidate(rawPos, enemyRoot, myChar, enemyChar, mode)
		if pos then
			return pos
		end
	end

	-- Hard fallback: this is the "actually move" part.
	-- It avoids the old behaviour where safety checks made retreat do nothing.
	local fallback = candidates[1]
	local grounded = findGroundedPosition(fallback, myChar, enemyChar)
	return grounded or fallback
end

local function resetMeleeFollowState()
	FOLLOW_MODE = "NORMAL"
	FOLLOW_MODE_STARTED = 0
	FOLLOW_LOCKED_RETREAT_POS = nil
	FOLLOW_LAST_DANGER_ACTIVE = false
	FOLLOW_LAST_DANGER_REASON = "none"
	FOLLOW_LAST_TOOL_NAME = "none"
	FOLLOW_LAST_SLOT = "?"
	FOLLOW_DANGER_CACHE_PLAYER = nil
	FOLLOW_DANGER_CACHE_UNTIL = 0
	clearFollowPositionCache()
	setMeleeAttackInvis(false)
	setSafeInvisChair(false)
end

local function setFollowMode(mode)
	if FOLLOW_MODE ~= mode then
		FOLLOW_MODE = mode
		FOLLOW_MODE_STARTED = os.clock()
		FOLLOW_LOCKED_RETREAT_POS = nil
	end
end

local function updateFollowMode(dangerActive)
	if not dangerActive then
		resetMeleeFollowState()
		return "NORMAL"
	end

	if not FOLLOW_LAST_DANGER_ACTIVE then
		FOLLOW_LAST_DANGER_ACTIVE = true
		setFollowMode("RETREAT")
		return FOLLOW_MODE
	end

	local now = os.clock()

	if FOLLOW_MODE == "RETREAT" then
		if now - FOLLOW_MODE_STARTED >= followSetting("FOLLOW_MELEE_SAFE_SECONDS", 3) then
			setFollowMode("PULSE")
		end
	elseif FOLLOW_MODE == "PULSE" then
		if now - FOLLOW_MODE_STARTED >= followSetting("FOLLOW_MELEE_ATTACK_SECONDS", 1) then
			setFollowMode("RETREAT")
		end
	else
		setFollowMode("RETREAT")
	end

	return FOLLOW_MODE
end

local function toggleFollow()
	FOLLOW_ENABLED = not FOLLOW_ENABLED
	ORBIT_PAUSED_UNSAFE = false
	ORBIT_DANGER_REASON = "starting"
	resetMeleeFollowState()

	followButton.Text =
		"ORBIT/FOLLOW [P] : " ..
		(FOLLOW_ENABLED and "ON" or "OFF")
	setButtonState(followButton, FOLLOW_ENABLED)

	if FOLLOW_ENABLED then
		followTargetPlayer = getClosestEnemyPlayer()
		if not followTargetPlayer then
			statusLabel.Text = "Status: FOLLOW ON | No target found."
		end
	else
		followTargetPlayer = nil
		setMeleeAttackInvis(false)
		setSafeInvisChair(false)
	end
end

task.spawn(function()
