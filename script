local function isAliveCharacter(plr)
	if not plr or not plr.Character then
		return false
	end

	local hum = plr.Character:FindFirstChildOfClass("Humanoid")
	local root = plr.Character:FindFirstChild("HumanoidRootPart")

	return hum and hum.Health > 0 and root
end

local function isAimbotEnemy(plr)
	if not isAliveCharacter(plr) then
		return false
	end

	-- Uses the SAME strict enemy-team check as orbit/follow and ESP.
	if not isStrictEnemyTeamPlayer(plr) then
		return false
	end

	return true
end

local function getClosestAimbotTarget()
	local closest = nil
	local shortestDist = math.huge

	for _, plr in ipairs(Players:GetPlayers()) do
		if isAimbotEnemy(plr) then
			local head = plr.Character:FindFirstChild("Head")

			if head then
				local screenPos, visible =
					Camera:WorldToViewportPoint(head.Position)

				if visible then
					local mousePos = UIS:GetMouseLocation()

					local dist =
						(Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude

					if dist < shortestDist and dist < math.clamp(AIMBOT_RADIUS, 0, 1000) then
						shortestDist = dist
						closest = plr
					end
				end
			end
		end
	end

	return closest
end

local function toggleAimbot()
	AIMBOT_ENABLED = not AIMBOT_ENABLED

	aimbotButton.Text =
