-- Persistent config file name.
-- When file saving is supported, this creates/loads SKR_V1_Configs.json
-- in your executor/app workspace folder. Open it with Notepad, VS Code, or any text editor.
CONFIG_SAVE_FILE = "SKR_V1_Configs.json"
CONFIG_LEGACY_SAVE_FILE = "SKR_V1_CONFIGS.json"

function canUsePersistentConfigs()
	return type(writefile) == "function"
		and type(readfile) == "function"
		and type(isfile) == "function"
		and HttpService ~= nil
end

function saveConfigsToDisk()
	if not canUsePersistentConfigs() then
		if statusLabel then
			statusLabel.Text = "Saved for this session only. File saving is not supported here."
		end

		return false
	end

	-- Always write the current settings into the selected config before saving the JSON file.
	local activeName = selectedConfigName or "Default"
	if type(collectCurrentConfig) == "function" and savedConfigs and activeName ~= "" then
		savedConfigs[activeName] = collectCurrentConfig()
	end

	local payload = {
		selectedConfigName = activeName,
		autoLoadConfig = AUTOLOAD_CONFIG == true,
		savedConfigs = savedConfigs,
	}

	local okEncode, encoded = pcall(function()
		return HttpService:JSONEncode(payload)
	end)

	if not okEncode or not encoded then
		if statusLabel then
			statusLabel.Text = "Config JSON save failed."
		end

		return false
	end

	local okWrite = pcall(function()
		writefile(CONFIG_SAVE_FILE, encoded)
	end)

	-- Keep the old file name synced too, so older saves/scripts remain compatible.
	if okWrite and CONFIG_LEGACY_SAVE_FILE and CONFIG_LEGACY_SAVE_FILE ~= CONFIG_SAVE_FILE then
		pcall(function()
			writefile(CONFIG_LEGACY_SAVE_FILE, encoded)
		end)
	end

	if not okWrite then
		if statusLabel then
			statusLabel.Text = "Config file write failed."
		end

		return false
	end

	return true
end

function loadConfigsFromDisk()
	if not canUsePersistentConfigs() then
		return false
	end

	local fileToRead = CONFIG_SAVE_FILE
	local exists = false

	pcall(function()
		exists = isfile(CONFIG_SAVE_FILE)
	end)

	-- Compatibility with the older mixed-case file name.
	if not exists and CONFIG_LEGACY_SAVE_FILE then
		pcall(function()
			if isfile(CONFIG_LEGACY_SAVE_FILE) then
				fileToRead = CONFIG_LEGACY_SAVE_FILE
				exists = true
			end
		end)
	end

	if not exists then
		return false
	end

	local okRead, raw = pcall(function()
		return readfile(fileToRead)
	end)

	if not okRead or type(raw) ~= "string" or raw == "" then
		return false
	end

	local okDecode, decoded = pcall(function()
		return HttpService:JSONDecode(raw)
	end)

	if not okDecode or type(decoded) ~= "table" then
		return false
	end

	AUTOLOAD_CONFIG = decoded.autoLoadConfig == true

	if type(decoded.savedConfigs) == "table" then
		for name, cfg in pairs(decoded.savedConfigs) do
			if type(name) == "string" and type(cfg) == "table" then
				savedConfigs[name] = cfg
			end
		end
	end

	if type(decoded.selectedConfigName) == "string" and savedConfigs[decoded.selectedConfigName] then
		selectedConfigName = decoded.selectedConfigName
	else
		selectedConfigName = "Default"
	end

	if configBox then
		configBox.Text = selectedConfigName
	end

	return true
end


function serializeConfigValue(value)
	if typeof and typeof(value) == "Vector3" then
		return {__type = "Vector3", x = value.X, y = value.Y, z = value.Z}
	end

	if typeof and typeof(value) == "EnumItem" then
		return {__type = "EnumItem", enum = tostring(value.EnumType), name = value.Name}
	end

	if type(value) == "number" or type(value) == "boolean" or type(value) == "string" then
		return value
	end

	return nil
end

function deserializeConfigValue(value)
	if type(value) ~= "table" then
		return value
	end

	if value.__type == "Vector3" then
		return Vector3.new(tonumber(value.x) or 0, tonumber(value.y) or 0, tonumber(value.z) or 0)
	end

	if value.__type == "EnumItem" then
		if value.enum == "Enum.KeyCode" and Enum.KeyCode[value.name] then
			return Enum.KeyCode[value.name]
		end
	end

	return nil
end

function collectConfigTable()
	local data = {}

	for key, value in pairs(CONFIG) do
		local encoded = serializeConfigValue(value)
		if encoded ~= nil then
			data[key] = encoded
		end
	end

	return data
end

function applyConfigTable(data)
	if type(data) ~= "table" then
		return
	end

	for key, value in pairs(data) do
		if CONFIG[key] ~= nil then
			local decoded = deserializeConfigValue(value)
			if decoded ~= nil then
				CONFIG[key] = decoded
			end
		end
	end

	-- Keep the enemy-only behavior even if an old config says otherwise.
	CONFIG.ALLOW_NEUTRAL_TARGETS = false
end

function collectCurrentConfig()
	return {
		-- Button/toggle states
		ESP_ENABLED = ESP_ENABLED,
		FLY_ENABLED = FLY_ENABLED,
		FOLLOW_ENABLED = FOLLOW_ENABLED,
		FIRE_TEST_ENABLED = FIRE_TEST_ENABLED,
