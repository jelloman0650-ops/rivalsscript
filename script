		FOLLOW_MELEE_SAFE_SECONDS = CONFIG.FOLLOW_MELEE_SAFE_SECONDS,
		FOLLOW_MELEE_ATTACK_SECONDS = CONFIG.FOLLOW_MELEE_ATTACK_SECONDS,
		FOLLOW_MELEE_SAFE_DISTANCE = CONFIG.FOLLOW_MELEE_SAFE_DISTANCE,

		-- Full CONFIG table so new settings survive save/load/autoload.
		CONFIG_DATA = collectConfigTable(),
	}
end

function applyConfig(data)
	if not data then
		return
	end

	if data.CONFIG_DATA then
		applyConfigTable(data.CONFIG_DATA)
	end

	-- Restore toggles.
	ESP_ENABLED = data.ESP_ENABLED == true
	FLY_ENABLED = data.FLY_ENABLED == true
	FOLLOW_ENABLED = data.FOLLOW_ENABLED == true
	-- Removed features stay forced off so old configs cannot re-enable them.
	FIRE_TEST_ENABLED = false
	AUTOCLICK_ENABLED = data.AUTOCLICK_ENABLED == true
	HEAD_CAM_ENABLED = false
	CAMERA_LOCK_ENABLED = false
	FORCE_MELEE_RETREAT = data.FORCE_MELEE_RETREAT == true
	AIMBOT_ENABLED = data.AIMBOT_ENABLED == true

	-- Restore numeric/runtime settings.
	if data.AIMBOT_RADIUS ~= nil then
		AIMBOT_RADIUS = math.clamp(tonumber(data.AIMBOT_RADIUS) or AIMBOT_RADIUS, 0, 1000)
	end

	if data.AIMBOT_SMOOTHNESS ~= nil then
		AIMBOT_SMOOTHNESS = math.clamp(tonumber(data.AIMBOT_SMOOTHNESS) or AIMBOT_SMOOTHNESS, 0.01, 1)
	end

	if data.AIMBOT_FACE_CHARACTER ~= nil then
		AIMBOT_FACE_CHARACTER = data.AIMBOT_FACE_CHARACTER == true
	end

	if data.AIMBOT_BODY_TURN_SMOOTHNESS ~= nil then
		AIMBOT_BODY_TURN_SMOOTHNESS = math.clamp(tonumber(data.AIMBOT_BODY_TURN_SMOOTHNESS) or AIMBOT_BODY_TURN_SMOOTHNESS, 0.05, 1)
	end

	-- Backwards compatibility with older saved config files.
	-- All melee settings can now load/save 0 instead of being forced to 0.5+.
	if data.FOLLOW_MELEE_SLOT ~= nil then
		CONFIG.FOLLOW_MELEE_SLOT = math.clamp(math.floor((tonumber(data.FOLLOW_MELEE_SLOT) or CONFIG.FOLLOW_MELEE_SLOT) + 0.5), 0, 100)
	end
	if data.FOLLOW_MELEE_SAFE_SECONDS ~= nil then
