TEAM_ATTRIBUTE_NAMES = {
	"Team",
	"TeamName",
	"TeamColor",
	"TeamColour",
	"Faction",
	"Side",
	"Squad",
	"Color",
	"Colour",
	"TeamId",
	"TeamID",
	"RoundTeam",
	"MatchTeam"
}

function normalizeTeamText(value)
	if value == nil then
		return nil
	end

	local text = tostring(value)
	if text == "" then
		return nil
	end

	local lowered = string.lower(text)
	if lowered == "nil"
		or lowered == "none"
		or lowered == "neutral"
		or lowered == "no team"
		or lowered == "noteam"
		or lowered == "default" then
		return nil
	end

	return text
end

function valueToTeamText(value)
	if value == nil then
		return nil
	end

	if typeof then
		local valueType = typeof(value)

		if valueType == "BrickColor" then
			return normalizeTeamText(tostring(value))
		end

		if valueType == "Color3" then
			return string.format(
				"%.3f,%.3f,%.3f",
				math.floor(value.R * 1000 + 0.5) / 1000,
				math.floor(value.G * 1000 + 0.5) / 1000,
				math.floor(value.B * 1000 + 0.5) / 1000
			)
		end
	end

	return normalizeTeamText(value)
end

function isDefaultTeamColor(teamColor)
	if teamColor == nil then
		return true
	end

	local text = tostring(teamColor)
	local lowered = string.lower(text)

	if lowered == "medium stone grey"
		or lowered == "medium stone gray"
		or lowered == "grey"
		or lowered == "gray"
		or lowered == "white"
		or lowered == "institutional white" then
		return true
	end

	local ok, defaultGrey = pcall(function()
		return BrickColor.new("Medium stone grey")
	end)

	if ok and tostring(defaultGrey) == text then
		return true
	end

	return false
end

function getTeamFromAttributesAndValues(obj, prefix)
	if not obj then
		return nil
	end

	for _, attr in ipairs(TEAM_ATTRIBUTE_NAMES) do
		local value = nil
		pcall(function()
			value = obj:GetAttribute(attr)
		end)

		local text = valueToTeamText(value)
		if text ~= nil then
			return prefix .. "Attr:" .. attr .. ":" .. text
		end

		local child = obj:FindFirstChild(attr)
		if child and child:IsA("ValueBase") then
			text = valueToTeamText(child.Value)
			if text ~= nil then
				return prefix .. "Value:" .. attr .. ":" .. text
			end
		end
	end

	return nil
end

function getTeamFromLeaderstats(plr)
	local leaderstats = plr and plr:FindFirstChild("leaderstats")
	if not leaderstats then
		return nil
	end

	return getTeamFromAttributesAndValues(leaderstats, "Leaderstats")
end

function getColorBucket(color)
	if not color then
		return nil
	end

	local r = color.R or 0
	local g = color.G or 0
	local b = color.B or 0
	local maxChannel = math.max(r, g, b)
	local minChannel = math.min(r, g, b)

	-- Ignore black/white/grey/low-saturation avatar parts.
	if maxChannel < 0.18 then
		return nil
	end

	if maxChannel - minChannel < 0.22 then
		return nil
	end

	return string.format(
		"%02d,%02d,%02d",
		math.floor(r * 15 + 0.5),
		math.floor(g * 15 + 0.5),
		math.floor(b * 15 + 0.5)
	)
end

function getTeamFromCharacterColor(char)
	if not char then
		return nil
	end

	-- Some games put a direct team color on the character instead of Player.Team.
	local direct = getTeamFromAttributesAndValues(char, "Character")
	if direct then
		return direct
	end

	local bodyColors = char:FindFirstChildOfClass("BodyColors")
	if bodyColors then
		local colors = {
			bodyColors.HeadColor,
			bodyColors.LeftArmColor,
			bodyColors.RightArmColor,
			bodyColors.LeftLegColor,
			bodyColors.RightLegColor,
			bodyColors.TorsoColor
		}

		local counts = {}
		local bestKey = nil
		local bestCount = 0

		for _, brick in ipairs(colors) do
			if brick and not isDefaultTeamColor(brick) then
				local key = "BodyColor:" .. tostring(brick)
				counts[key] = (counts[key] or 0) + 1
				if counts[key] > bestCount then
					bestCount = counts[key]
					bestKey = key
				end
			end
		end

		if bestKey and bestCount >= 2 then
			return bestKey
		end
	end

	-- Final fallback for yellow/blue style Studio teams that are stored as character part colors.
	local counts = {}
	local bestKey = nil
	local bestCount = 0

	for _, obj in ipairs(char:GetDescendants()) do
		if obj:IsA("BasePart") and obj.Transparency < 0.95 then
			local lowerName = string.lower(obj.Name)
			local skipPart = string.find(lowerName, "humanoidrootpart", 1, true)
				or string.find(lowerName, "handle", 1, true)
				or string.find(lowerName, "effect", 1, true)
				or string.find(lowerName, "trail", 1, true)

			if not skipPart then
				local bucket = getColorBucket(obj.Color)
				if bucket then
					local key = "CharColor:" .. bucket
					counts[key] = (counts[key] or 0) + 1
					if counts[key] > bestCount then
						bestCount = counts[key]
						bestKey = key
					end
				end
			end
		end
	end

	if bestKey and bestCount >= 2 then
		return bestKey
	end

	return nil
end

function getTeamObjectKey(plr)
	if not plr or plr.Team == nil then
		return nil
	end

	local teamName = normalizeTeamText(plr.Team.Name)
	if teamName then
		return "Team:" .. teamName
	end

	return nil
end

function getTeamColorKey(plr)
	if not plr or plr.TeamColor == nil or isDefaultTeamColor(plr.TeamColor) then
		return nil
	end

	local colorText = valueToTeamText(plr.TeamColor)
	if colorText then
		return "TeamColor:" .. colorText
	end

	return nil
end

function getReliableTeamKey(plr)
	if not plr then
		return nil
	end

	-- Strongest Roblox team check.
	local teamKey = getTeamObjectKey(plr)
	if teamKey then
		return teamKey
	end

	-- Fallback for games that mainly use Player.TeamColor.
	local colorKey = getTeamColorKey(plr)
	if colorKey then
		return colorKey
	end

	local valueTeam = getTeamFromAttributesAndValues(plr, "Player")
	if valueTeam then
		return valueTeam
	end

	local leaderTeam = getTeamFromLeaderstats(plr)
	if leaderTeam then
		return leaderTeam
	end

	local characterTeam = getTeamFromCharacterColor(plr.Character)
	if characterTeam then
		return characterTeam
	end

	-- No reliable team data. Do not target.
	return nil
end

function isStrictEnemyTeamPlayer(plr)
	if not plr or plr == LocalPlayer then
		return false
	end

	-- Compare matching Roblox team sources first so teammates are never treated as enemies.
	local myTeamObject = getTeamObjectKey(LocalPlayer)
	local theirTeamObject = getTeamObjectKey(plr)
	if myTeamObject and theirTeamObject then
		return tostring(myTeamObject) ~= tostring(theirTeamObject)
	end

	local myTeamColor = getTeamColorKey(LocalPlayer)
	local theirTeamColor = getTeamColorKey(plr)
	if myTeamColor and theirTeamColor then
		return tostring(myTeamColor) ~= tostring(theirTeamColor)
	end

	local myTeam = getReliableTeamKey(LocalPlayer)
	local theirTeam = getReliableTeamKey(plr)

	-- Enemy-only rule: if either side has no reliable team data, do not target.
	if myTeam == nil or theirTeam == nil then
		return false
	end

	return tostring(myTeam) ~= tostring(theirTeam)
end

function sameTeam(plr)
	if not plr or plr == LocalPlayer then
		return true
	end

	local myTeam = getReliableTeamKey(LocalPlayer)
	local theirTeam = getReliableTeamKey(plr)

	if myTeam == nil or theirTeam == nil then
		return false
	end

	return tostring(myTeam) == tostring(theirTeam)
end

function isEnemyPlayer(plr)
	if not isStrictEnemyTeamPlayer(plr) then
		return false
	end

	if not plr.Character then
		return false
	end

	local hum = plr.Character:FindFirstChildOfClass("Humanoid")
	local root = plr.Character:FindFirstChild("HumanoidRootPart")

	return hum and hum.Health > 0 and root ~= nil
end

