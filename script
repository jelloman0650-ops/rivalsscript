	if gp then return end

	if input.KeyCode == Enum.KeyCode.E then
		-- When AutoClick is on, it is spamming E, so do not let those E presses toggle ESP.
		if not AUTOCLICK_ENABLED then
			toggleESP()
		end
	elseif input.KeyCode == Enum.KeyCode.F then
		toggleFly()
	elseif false then -- CAMERA LOCK keybind removed
		toggleCameraLock()
	elseif input.KeyCode == Enum.KeyCode.C then
		toggleAutoclick()
	elseif input.KeyCode == Enum.KeyCode.P then
		toggleFollow()
	elseif false then -- FIRE TEST keybind removed
		toggleFireTest()
	elseif false then -- HEAD CAM keybind removed
		toggleHeadCam()
	elseif input.KeyCode == Enum.KeyCode.O then
		toggleForceMeleeRetreat()
	elseif input.KeyCode == Enum.KeyCode.RightShift then
		local now = os.clock()
		if now - (UI_TOGGLE_LAST_TIME or 0) >= 0.20 then
			UI_TOGGLE_LAST_TIME = now
			UI_USER_TOGGLED_PANEL = true
			frame.Visible = not frame.Visible
		end
	end
end)

