RunService.RenderStepped:Connect(function()
	aimbotCircle.Position =
		Vector2.new(
			Camera.ViewportSize.X / 2,
			Camera.ViewportSize.Y / 2
		)

	aimbotCircle.Radius = math.clamp(AIMBOT_RADIUS, 0, 1000)

	aimbotHue = (aimbotHue + 0.005) % 1
	aimbotCircle.Color = Color3.fromHSV(aimbotHue, 1, 1)

	if not AIMBOT_ENABLED then
		return
	end

	local now = tick()

	-- Keep target locked until dead / invalid / teammate.
	if AIMBOT_LOCKED_TARGET and not isAimbotEnemy(AIMBOT_LOCKED_TARGET) then
		AIMBOT_LOCKED_TARGET = nil
	end

	-- Keep searching until we get one target, then stay on it.
	if (not AIMBOT_LOCKED_TARGET) and (now - AIMBOT_LAST_SWITCH) >= AIMBOT_SWITCH_DELAY then
		local newTarget = getClosestAimbotTarget()

		if newTarget then
			AIMBOT_LOCKED_TARGET = newTarget
		end

		AIMBOT_LAST_SWITCH = now
	end

	if not AIMBOT_LOCKED_TARGET
		or not AIMBOT_LOCKED_TARGET.Character
		or not isAimbotEnemy(AIMBOT_LOCKED_TARGET) then
		return
	end

	local targetChar = AIMBOT_LOCKED_TARGET.Character
	local targetPart =
		targetChar:FindFirstChild("Head")
		or targetChar:FindFirstChild("UpperTorso")
		or targetChar:FindFirstChild("HumanoidRootPart")
		or targetChar:FindFirstChild("Torso")

	if not targetPart then
		return
	end

	local targetPos = targetPart.Position + Vector3.new(0, 0.12, 0)

	-- Turn your whole character/root toward the enemy so the weapon faces the same way as the camera.
	local myChar = LocalPlayer.Character
	local myRoot = myChar and (
		myChar:FindFirstChild("HumanoidRootPart")
		or myChar:FindFirstChild("UpperTorso")
		or myChar:FindFirstChild("Torso")
	)

	if AIMBOT_FACE_CHARACTER and myChar and myRoot then
		local hum = myChar:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.AutoRotate = false
		end

		local flatTarget =
			Vector3.new(
				targetPos.X,
				myRoot.Position.Y,
				targetPos.Z
			)

		if (flatTarget - myRoot.Position).Magnitude > 0.05 then
			local desiredRoot =
				CFrame.new(myRoot.Position, flatTarget)

			myRoot.CFrame =
				myRoot.CFrame:Lerp(
					desiredRoot,
					math.clamp(AIMBOT_BODY_TURN_SMOOTHNESS, 0.05, 1)
				)
		end
	end

	-- Aim the camera at the same target so first-person weapon/viewmodel lines up.
	local camPos = Camera.CFrame.Position
	local desiredCamera = CFrame.new(camPos, targetPos)

	Camera.CFrame =
		Camera.CFrame:Lerp(
			desiredCamera,
			math.clamp(AIMBOT_SMOOTHNESS, 0.01, 1)
		)
end)



