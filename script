	else
		AIMBOT_LOCKED_TARGET = nil
		currentAimbotTarget = nil

		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.AutoRotate = true
		end
	end
end

