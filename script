	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(155, 20, 20)
	stroke.Thickness = 1.5
	stroke.Transparency = 0.25
	stroke.Parent = holder

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(0.42, 0, 1, 0)
	nameLabel.Position = UDim2.new(0.02, 0, 0, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.TextColor3 = Color3.fromRGB(255, 235, 235)
	nameLabel.Font = Enum.Font.GothamBlack
	nameLabel.TextScaled = true
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.Parent = holder

	local valueLabel = Instance.new("TextLabel")
	valueLabel.Size = UDim2.new(0.16, 0, 1, 0)
	valueLabel.Position = UDim2.new(0.82, 0, 0, 0)
	valueLabel.BackgroundTransparency = 1
	valueLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
	valueLabel.Font = Enum.Font.GothamBlack
	valueLabel.TextScaled = true
	valueLabel.TextXAlignment = Enum.TextXAlignment.Right
	valueLabel.Parent = holder

	local bar = Instance.new("Frame")
	bar.Size = UDim2.new(0.34, 0, 0, 8)
	bar.Position = UDim2.new(0.46, 0, 0.5, -4)
	bar.BackgroundColor3 = Color3.fromRGB(55, 24, 26)
	bar.BorderSizePixel = 0
	bar.Parent = holder

	local barCorner = Instance.new("UICorner")
	barCorner.CornerRadius = UDim.new(1, 0)
	barCorner.Parent = bar

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(0, 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
	fill.BorderSizePixel = 0
	fill.Parent = bar

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(1, 0)
	fillCorner.Parent = fill

	local knob = Instance.new("Frame")
	knob.Size = UDim2.new(0, 18, 0, 18)
	knob.Position = UDim2.new(0, -9, 0.5, -9)
	knob.BackgroundColor3 = Color3.fromRGB(255, 230, 230)
	knob.BorderSizePixel = 0
	knob.Parent = bar

	local knobCorner = Instance.new("UICorner")
	knobCorner.CornerRadius = UDim.new(1, 0)
	knobCorner.Parent = knob

	local currentValue = defaultValue
	local dragging = false

	local function roundToStep(value)
		local step = stepValue or 1
		return math.floor((value / step) + 0.5) * step
	end

	local function formatValue(value)
		if math.abs(value - math.floor(value + 0.5)) < 0.001 then
			return tostring(math.floor(value + 0.5))
		end
		return string.format("%.1f", value)
	end

	local function setValue(value, fireCallback)
		value = math.clamp(roundToStep(value), minValue, maxValue)
		currentValue = value
		local alpha = 0
		if maxValue > minValue then
			alpha = (value - minValue) / (maxValue - minValue)
		end
		fill.Size = UDim2.new(alpha, 0, 1, 0)
		knob.Position = UDim2.new(alpha, -9, 0.5, -9)
		nameLabel.Text = labelText
		valueLabel.Text = formatValue(value)
		if fireCallback and onChanged then
			onChanged(value)
		end
	end

	local function setFromX(x)
		local rel = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
		setValue(minValue + (maxValue - minValue) * rel, true)
	end

	holder.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end)

	bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end)

	UIS.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end)

	UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	setValue(defaultValue, false)
	return {
		SetValue = function(value)
			setValue(value, true)
		end,
		GetValue = function()
			return currentValue
		end,
	}
end

