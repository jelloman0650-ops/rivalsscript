local Players = game:GetService("Players")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- GUI
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "WeatherGUI"
screenGui.Parent = playerGui
screenGui.ResetOnSpawn = false

-- Main frame
local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 220, 0, 120)
frame.Position = UDim2.new(0, 20, 0, 20)
frame.BackgroundColor3 = Color3.fromRGB(40,40,40)
frame.Parent = screenGui

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1,0,0,30)
title.BackgroundTransparency = 1
title.Text = "Weather Toggle"
title.TextColor3 = Color3.new(1,1,1)
title.Parent = frame

-- Snow button
local snowButton = Instance.new("TextButton")
snowButton.Size = UDim2.new(0,180,0,35)
snowButton.Position = UDim2.new(0,20,0,40)
snowButton.Text = "Toggle Snow"
snowButton.Parent = frame

-- Rain button
local rainButton = Instance.new("TextButton")
rainButton.Size = UDim2.new(0,180,0,35)
rainButton.Position = UDim2.new(0,20,0,80)
rainButton.Text = "Toggle Rain"
rainButton.Parent = frame

-- Overlay for weather
local overlay = Instance.new("Frame")
overlay.Size = UDim2.new(1,0,1,0)
overlay.BackgroundTransparency = 1
overlay.Parent = screenGui

local activeWeather = nil

-- Function to clear weather
local function clearWeather()
	for _, v in pairs(overlay:GetChildren()) do
		v:Destroy()
	end
	activeWeather = nil
end

-- Snow effect
local function makeSnow()
	clearWeather()
	activeWeather = "snow"

	for i = 1, 80 do
		local flake = Instance.new("TextLabel")
		flake.BackgroundTransparency = 1
		flake.Text = "❄"
		flake.TextScaled = true
		flake.TextColor3 = Color3.new(1,1,1)

		local size = math.random(15,35)

		flake.Size = UDim2.new(0,size,0,size)
		flake.Position = UDim2.new(math.random(),0,-0.1,0)

		flake.Parent = overlay

		task.spawn(function()
			while flake.Parent and activeWeather == "snow" do
				flake.Position = UDim2.new(
					flake.Position.X.Scale,
					0,
					flake.Position.Y.Scale + 0.003,
					0
				)

				if flake.Position.Y.Scale > 1 then
					flake.Position = UDim2.new(math.random(),0,-0.1,0)
				end

				task.wait(0.02)
			end
		end)
	end
end

-- Rain effect
local function makeRain()
	clearWeather()
	activeWeather = "rain"

	for i = 1, 120 do
		local drop = Instance.new("Frame")
		drop.BorderSizePixel = 0
		drop.BackgroundColor3 = Color3.fromRGB(180,180,255)

		drop.Size = UDim2.new(0,2,0,20)
		drop.Position = UDim2.new(math.random(),0,-0.1,0)

		drop.Parent = overlay

		task.spawn(function()
			while drop.Parent and activeWeather == "rain" do
				drop.Position = UDim2.new(
					drop.Position.X.Scale - 0.001,
					0,
					drop.Position.Y.Scale + 0.02,
					0
				)

				if drop.Position.Y.Scale > 1 then
					drop.Position = UDim2.new(math.random(),0,-0.1,0)
				end

				task.wait(0.02)
			end
		end)
	end
end

-- Toggle buttons
snowButton.MouseButton1Click:Connect(function()
	if activeWeather == "snow" then
		clearWeather()
	else
		makeSnow()
	end
end)

rainButton.MouseButton1Click:Connect(function()
	if activeWeather == "rain" then
		clearWeather()
	else
		makeRain()
	end
end)
