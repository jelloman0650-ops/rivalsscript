function updateAutoloadButton()
	if not autoloadConfigButton then
		return
	end

	local stateText = AUTOLOAD_CONFIG and "ON" or "OFF"
	local nameText = selectedConfigName or "Default"

	autoloadConfigButton.Text = "AUTOLOAD CONFIG : " .. stateText .. " (" .. nameText .. ")"
	setButtonState(autoloadConfigButton, AUTOLOAD_CONFIG == true)
end

function runAutoLoadConfig()
	if AUTOLOAD_CONFIG ~= true then
		return false
	end

	local name = selectedConfigName or "Default"
	local cfg = savedConfigs[name] or savedConfigs.Default

	if cfg then
		selectedConfigName = name
		if configBox then
			configBox.Text = name
		end

		applyConfig(cfg)
		refreshConfigList()
		updateAutoloadButton()

		if statusLabel then
			statusLabel.Text = "Auto-loaded config: " .. tostring(name)
		end

		return true
	end

	if statusLabel then
		statusLabel.Text = "Autoload failed. Config not found: " .. tostring(name)
	end

	return false
end


function ensureConfigHasDefaults(cfg)
	if type(cfg) ~= "table" or type(collectCurrentConfig) ~= "function" then
		return cfg
	end

	local defaults = collectCurrentConfig()

	for key, value in pairs(defaults) do
		if cfg[key] == nil then
			cfg[key] = value
		end
	end

	if type(cfg.CONFIG_DATA) ~= "table" then
		cfg.CONFIG_DATA = defaults.CONFIG_DATA
	elseif type(defaults.CONFIG_DATA) == "table" then
		for key, value in pairs(defaults.CONFIG_DATA) do
			if cfg.CONFIG_DATA[key] == nil then
				cfg.CONFIG_DATA[key] = value
			end
		end
	end

	-- Keep enemy-only and removed-feature behavior even for old saved configs.
	if type(cfg.CONFIG_DATA) == "table" then
		cfg.CONFIG_DATA.ALLOW_NEUTRAL_TARGETS = false
	end
	cfg.FIRE_TEST_ENABLED = false
	cfg.HEAD_CAM_ENABLED = false
	cfg.CAMERA_LOCK_ENABLED = false

	return cfg
end

function normalizeSavedConfigs()
	if type(savedConfigs) ~= "table" then
		return
	end

	if type(savedConfigs.Default) ~= "table" then
		savedConfigs.Default = collectCurrentConfig()
	end

	for name, cfg in pairs(savedConfigs) do
		if type(name) == "string" and type(cfg) == "table" then
			savedConfigs[name] = ensureConfigHasDefaults(cfg)
		end
	end
end


function refreshConfigList()
	for _, child in ipairs(configListFrame:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local names = {}
	for name, _ in pairs(savedConfigs) do
		table.insert(names, name)
	end
	table.sort(names)

	for _, name in ipairs(names) do
		local item = Instance.new("TextButton")
		item.Size = UDim2.new(1, -8, 0, 28)
		item.BackgroundColor3 =
			(name == selectedConfigName)
			and Color3.fromRGB(100, 18, 18)
			or Color3.fromRGB(28, 18, 20)

		item.TextColor3 = Color3.fromRGB(255, 245, 245)
		item.Text = name
		item.Font = Enum.Font.GothamBlack
		item.TextScaled = true
		item.AutoButtonColor = false
		item.Parent = configListFrame

		local itemCorner = Instance.new("UICorner")
		itemCorner.CornerRadius = UDim.new(0, 8)
		itemCorner.Parent = item

		local itemStroke = Instance.new("UIStroke")
		itemStroke.Color = Color3.fromRGB(255, 40, 40)
		itemStroke.Thickness = 1
		itemStroke.Transparency = (name == selectedConfigName) and 0.1 or 0.55
		itemStroke.Parent = item

		item.MouseButton1Click:Connect(function()
			selectedConfigName = name
			configBox.Text = name
			refreshConfigList()
			statusLabel.Text = "Selected config: " .. name
		end)
	end

	configListFrame.CanvasSize = UDim2.new(0, 0, 0, math.max(#names * 32, 100))
	updateAutoloadButton()
end


