end)

RunService.RenderStepped:Connect(function()
	if not FOLLOW_ENABLED then
		return
	end

	local myChar = LocalPlayer.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")

	if not myRoot or not myHum or myHum.Health <= 0 then
		statusLabel.Text = "Status: FOLLOW ON | local character not ready"
		return
	end

	if not followTargetPlayer or not isEnemyPlayer(followTargetPlayer) then
		followTargetPlayer = getClosestEnemyPlayer()

		if not followTargetPlayer then
			statusLabel.Text = "Status: FOLLOW ON | No target found."
			return
		end
	end

	if FOLLOW_LAST_TARGET_PLAYER ~= followTargetPlayer then
		FOLLOW_LAST_TARGET_PLAYER = followTargetPlayer
		resetMeleeFollowState()
	end

	local enemyChar = followTargetPlayer.Character
	local enemyRoot = enemyChar and getRoot(enemyChar)
	local enemyHum = enemyChar and enemyChar:FindFirstChildOfClass("Humanoid")

	if not enemyRoot or not enemyHum or enemyHum.Health <= 0 then
		statusLabel.Text = "Status: FOLLOW ON | target not ready"
		return
	end

	if (enemyRoot.Position - myRoot.Position).Magnitude > followSetting("FOLLOW_MAX_TARGET_DISTANCE", 240) then
		FOLLOW_LOCKED_RETREAT_POS = nil
		setFollowStatus("Status: FOLLOW paused | target too far")
		return
	end

	local detectedDanger, dangerReason = getCachedEnemyDangerActive(followTargetPlayer, enemyChar)
	local dangerActive = detectedDanger or FORCE_MELEE_RETREAT
	FOLLOW_LAST_DANGER_REASON = FORCE_MELEE_RETREAT and "FORCE RETREAT TEST" or (dangerReason or "none")

	local mode = updateFollowMode(dangerActive)
	local targetPos
	local now = os.clock()

	if mode == "RETREAT" then
		-- Lock the retreat position for the whole retreat period, so it does not orbit/spin.
		if not FOLLOW_LOCKED_RETREAT_POS then
			FOLLOW_LOCKED_RETREAT_POS = pickPosition(enemyRoot, myRoot, myChar, enemyChar, "RETREAT")
		end
		targetPos = FOLLOW_LOCKED_RETREAT_POS
	else
		FOLLOW_LOCKED_RETREAT_POS = nil

		local canReuse =
			FOLLOW_LAST_COMPUTED_POS ~= nil
			and FOLLOW_LAST_COMPUTED_MODE == mode
			and FOLLOW_LAST_COMPUTED_TARGET == followTargetPlayer
			and now < FOLLOW_NEXT_POSITION_UPDATE

		if canReuse then
			targetPos = FOLLOW_LAST_COMPUTED_POS
		else
			targetPos = pickPosition(enemyRoot, myRoot, myChar, enemyChar, mode == "PULSE" and "PULSE" or "NORMAL")
			FOLLOW_LAST_COMPUTED_POS = targetPos
			FOLLOW_LAST_COMPUTED_MODE = mode
			FOLLOW_LAST_COMPUTED_TARGET = followTargetPlayer
			FOLLOW_NEXT_POSITION_UPDATE = now + (CONFIG.FOLLOW_POSITION_REFRESH or 0.045)
		end
	end

	-- Important order:
	-- RETREAT = safe chair on, attack invis off.
	-- PULSE = chair off first, attack invis on, then hard-move/attack.
	if mode == "PULSE" then
		setSafeInvisChair(false)
		setMeleeAttackInvis(dangerActive and (CONFIG.MELEE_ATTACK_INVIS ~= false))
	elseif mode == "RETREAT" then
		setMeleeAttackInvis(false)
	else
		setMeleeAttackInvis(false)
		setSafeInvisChair(false)
	end

	if not targetPos then
		ORBIT_PAUSED_UNSAFE = true
		zeroRootVelocityIfNeeded(myRoot)
		setFollowStatus("Status: FOLLOW paused | " .. tostring(ORBIT_DANGER_REASON))
		return
	end

	local lookAt = enemyRoot.Position + Vector3.new(0, 1.5, 0)
	local desiredCFrame = CFrame.new(targetPos, lookAt)

	zeroRootVelocityIfNeeded(myRoot)

	-- Hard move for RETREAT and PULSE so it actually goes safe, then actually attacks behind.
	if mode == "RETREAT" or mode == "PULSE" then
		myRoot.CFrame = desiredCFrame
	else
		local smooth = math.clamp(followSetting("FOLLOW_SMOOTHNESS", 0.82), 0.05, 1)
		if smooth >= 0.98 then
			myRoot.CFrame = desiredCFrame
		else
			myRoot.CFrame = myRoot.CFrame:Lerp(desiredCFrame, smooth)
		end
	end

	-- Turn the safe chair on only AFTER the retreat move, so it is created at the safe spot.
	if dangerActive and mode == "RETREAT" then
		setSafeInvisChair(true)
	elseif mode ~= "RETREAT" then
		setSafeInvisChair(false)
	end

	if dangerActive and mode == "PULSE" then
		followPulseAttackOnce()
	end

	if dangerActive then
		local elapsed = os.clock() - FOLLOW_MODE_STARTED

		if mode == "RETREAT" then
			local left = math.max(0, followSetting("FOLLOW_MELEE_SAFE_SECONDS", 3) - elapsed)
			setFollowStatus(
				"Status: FOLLOW V11 | SAFE CHAIR/RETREAT " .. string.format("%.1f", left) ..
				"s | " .. tostring(FOLLOW_LAST_DANGER_REASON) ..
				" | tool:" .. tostring(FOLLOW_LAST_TOOL_NAME) ..
				" | slot:" .. tostring(FOLLOW_LAST_SLOT)
			)
		elseif mode == "PULSE" then
			local left = math.max(0, followSetting("FOLLOW_MELEE_ATTACK_SECONDS", 1) - elapsed)
			setFollowStatus(
				"Status: FOLLOW V11 | BEHIND PULSE/HIDDEN/ATTACK " .. string.format("%.1f", left) ..
				"s | " .. tostring(FOLLOW_LAST_DANGER_REASON)
			)
		end
	else
		setFollowStatus(
			"Status: FOLLOW V11 -> " .. followTargetPlayer.Name ..
			" | behind back | tool:" .. tostring(FOLLOW_LAST_TOOL_NAME) ..
			" | slot:" .. tostring(FOLLOW_LAST_SLOT)
		)
	end
end)


