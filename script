local function followSetting(name, fallback)
	local value = CONFIG and CONFIG[name]
	if value == nil then
		return fallback
	end
	return value
end

local function lowerText(value)
	return string.lower(tostring(value or ""))
end

local function normalizeWeaponText(value)
	local text = lowerText(value)
	-- Keep letters and numbers only so "Subspace Tripmine", "SubspaceTripmine",
	-- and "subspace_tripmine" all match the same way.
	return string.gsub(text, "[^%w]", "")
end

local function hasKeyword(value, words)
	local text = lowerText(value)
	local compactText = normalizeWeaponText(value)

	for _, word in ipairs(words) do
		local rawWord = lowerText(word)
		local compactWord = normalizeWeaponText(word)

		if string.find(text, rawWord, 1, true) then
			return true
		end

		if compactWord ~= "" and string.find(compactText, compactWord, 1, true) then
			return true
		end
	end

	return false
end

local function numberFromValue(value)
	if type(value) == "number" then
		return value
	end

	if type(value) == "string" then
		local numberText = string.match(value, "%d+")
		if numberText then
			return tonumber(numberText)
		end
	end

	return nil
end

local function readNumberAttributeOrValue(inst, names)
	if not inst then
		return nil
	end

	for _, name in ipairs(names) do
		local ok, value = pcall(function()
			return inst:GetAttribute(name)
		end)

		if ok then
			local numberValue = numberFromValue(value)
			if numberValue then
				return math.floor(numberValue + 0.5)
			end
		end

		local child = inst:FindFirstChild(name)
		if child and child:IsA("ValueBase") then
			local numberValue = numberFromValue(child.Value)
			if numberValue then
				return math.floor(numberValue + 0.5)
			end
		end
	end

	return nil
end

local function readDeepNumberValue(inst, names)
	if not inst then
		return nil
	end

	for _, obj in ipairs(inst:GetDescendants()) do
		if obj:IsA("ValueBase") then
			for _, name in ipairs(names) do
				if obj.Name == name then
					local numberValue = numberFromValue(obj.Value)
					if numberValue then
						return math.floor(numberValue + 0.5)
					end
				end
			end
		end
	end

	return nil
end

local function readDeepWeaponText(inst)
	if not inst then
		return false, nil
	end

	for _, obj in ipairs(inst:GetDescendants()) do
		if obj:IsA("ValueBase") then
			for _, name in ipairs(WEAPON_TEXT_NAMES) do
				if obj.Name == name and hasKeyword(obj.Value, DANGER_WEAPON_KEYWORDS) then
					return true, "deep-value:" .. obj.Name .. "=" .. tostring(obj.Value)
				end
			end
		end

		for _, name in ipairs(WEAPON_TEXT_NAMES) do
			local ok, value = pcall(function()
				return obj:GetAttribute(name)
			end)

			if ok and value ~= nil and hasKeyword(value, DANGER_WEAPON_KEYWORDS) then
				return true, "deep-attribute:" .. name .. "=" .. tostring(value)
			end
		end
	end

	return false, nil
end

local function getReplicatedSlot(enemyPlayer, enemyChar, tool)
	local sources = {tool, enemyChar, enemyPlayer}

	if enemyPlayer then
		local stats = enemyPlayer:FindFirstChild("leaderstats")
		if stats then
			table.insert(sources, stats)
		end
	end

	for _, source in ipairs(sources) do
		local slot = readNumberAttributeOrValue(source, SLOT_NAMES)
		if slot then
			return slot
		end
	end

	for _, source in ipairs({enemyChar, enemyPlayer}) do
		local slot = readDeepNumberValue(source, SLOT_NAMES)
		if slot then
			return slot
		end
	end

	return nil
end

local function instanceWeaponMatch(inst)
	if not inst then
		return false, nil
	end

	if hasKeyword(inst.Name, DANGER_WEAPON_KEYWORDS) then
		return true, "name:" .. inst.Name
	end

	for _, name in ipairs(WEAPON_TEXT_NAMES) do
		local ok, value = pcall(function()
			return inst:GetAttribute(name)
		end)

		if ok and value ~= nil and hasKeyword(value, DANGER_WEAPON_KEYWORDS) then
			return true, "attribute:" .. name .. "=" .. tostring(value)
		end

		local child = inst:FindFirstChild(name)
		if child and child:IsA("ValueBase") and hasKeyword(child.Value, DANGER_WEAPON_KEYWORDS) then
			return true, "value:" .. child.Name .. "=" .. tostring(child.Value)
		end
	end

	if inst:IsA("ValueBase") and hasKeyword(inst.Value, DANGER_WEAPON_KEYWORDS) then
		return true, "value:" .. inst.Name .. "=" .. tostring(inst.Value)
	end

	return false, nil
end

local function enemyDangerActive(enemyPlayer, enemyChar)
	FOLLOW_LAST_TOOL_NAME = "none"
	FOLLOW_LAST_SLOT = "?"

	if not enemyChar then
		return false, "no character"
	end

	local tool = enemyChar:FindFirstChildOfClass("Tool")
	if tool then
		FOLLOW_LAST_TOOL_NAME = tool.Name
	end

	local slot = getReplicatedSlot(enemyPlayer, enemyChar, tool)
	if slot then
		FOLLOW_LAST_SLOT = tostring(slot)
	end

	local dangerSlot = math.floor(followSetting("FOLLOW_MELEE_SLOT", 3) + 0.5)
	if followSetting("DETECT_MELEE_SLOT", true) and slot and slot == dangerSlot then
		return true, "slot:" .. tostring(slot)
	end

	-- Strongest check: actual equipped Tool name/attributes/values.
	if tool then
		local matched, reason = instanceWeaponMatch(tool)
		if matched then
			return true, reason or ("tool:" .. tool.Name)
		end

		local deepMatched, deepReason = readDeepWeaponText(tool)
		if deepMatched then
			return true, deepReason or ("tool-deep:" .. tool.Name)
		end
	end

	-- Custom weapon systems often store the current weapon as an Attribute/StringValue
	-- on the Character or Player instead of using a Roblox Tool.
	for _, source in ipairs({enemyChar, enemyPlayer, enemyPlayer and enemyPlayer:FindFirstChild("leaderstats")}) do
		local matched, reason = instanceWeaponMatch(source)
		if matched then
			return true, reason or "replicated weapon text"
		end

		local deepMatched, deepReason = readDeepWeaponText(source)
		if deepMatched then
			return true, deepReason or "replicated deep weapon text"
		end
	end

	-- Last-resort scan. This now includes BaseParts/MeshParts because many custom
	-- knife/tripmine systems put a visible weapon model in the character, not a Tool.
	for _, obj in ipairs(enemyChar:GetDescendants()) do
		if obj:IsA("Tool")
			or obj:IsA("Accessory")
			or obj:IsA("Model")
			or obj:IsA("Folder")
			or obj:IsA("Configuration")
			or obj:IsA("BasePart")
			or obj:IsA("MeshPart")
			or obj:IsA("StringValue")
			or obj:IsA("ObjectValue") then

			local matched, reason = instanceWeaponMatch(obj)
			if matched then
				return true, reason or obj.Name
			end
		end
	end

	return false, "no replicated melee/knife/tripmine found"
end

local function getCachedEnemyDangerActive(enemyPlayer, enemyChar)
	local now = os.clock()
	if enemyPlayer == FOLLOW_DANGER_CACHE_PLAYER and now < FOLLOW_DANGER_CACHE_UNTIL then
		FOLLOW_LAST_TOOL_NAME = FOLLOW_DANGER_CACHE_TOOL
		FOLLOW_LAST_SLOT = FOLLOW_DANGER_CACHE_SLOT
		return FOLLOW_DANGER_CACHE_ACTIVE, FOLLOW_DANGER_CACHE_REASON
	end

	local active, reason = enemyDangerActive(enemyPlayer, enemyChar)
	FOLLOW_DANGER_CACHE_PLAYER = enemyPlayer
	FOLLOW_DANGER_CACHE_UNTIL = now + (CONFIG.FOLLOW_DETECTION_REFRESH or 0.25)
	FOLLOW_DANGER_CACHE_ACTIVE = active
	FOLLOW_DANGER_CACHE_REASON = reason or "none"
	FOLLOW_DANGER_CACHE_TOOL = FOLLOW_LAST_TOOL_NAME
	FOLLOW_DANGER_CACHE_SLOT = FOLLOW_LAST_SLOT
	return active, reason
end

