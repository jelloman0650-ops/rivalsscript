---------------------------------------------------
-- TARGET / TEAM SYSTEM
---------------------------------------------------

local function getCamera()
	return workspace.CurrentCamera
end

local function getRoot(char)
	if not char then return nil end

	return char:FindFirstChild("HumanoidRootPart")
		or char:FindFirstChild("UpperTorso")
		or char:FindFirstChild("Torso")
		or char:FindFirstChild("Head")
end

local function getHead(char)
	if not char then return nil end

	return char:FindFirstChild("Head") or getRoot(char)
end

local function zeroRootVelocityIfNeeded(root)
	if not root then
		return
	end

	-- Cheaper physics writes: do not keep writing zero when velocity is already zero.
	if root.AssemblyLinearVelocity.Magnitude > 0.05 then
		root.AssemblyLinearVelocity = Vector3.zero
	end

	if root.AssemblyAngularVelocity.Magnitude > 0.05 then
		root.AssemblyAngularVelocity = Vector3.zero
	end
end

local function getTeamValue(plr)
	return getReliableTeamKey(plr)
end


local function getClosestEnemyPlayer()
	local myChar = LocalPlayer.Character
	local myRoot = myChar and getRoot(myChar)

	local closestPlayer = nil
	local bestDistance = math.huge

	for _, plr in ipairs(Players:GetPlayers()) do
		if isEnemyPlayer(plr) and plr.Character then
			local enemyRoot = getRoot(plr.Character)

			if enemyRoot then
				local distance

				if myRoot then
					distance = (enemyRoot.Position - myRoot.Position).Magnitude
				else
					local cam = getCamera()
					if cam then
						local screenPos, visible = cam:WorldToViewportPoint(enemyRoot.Position)

						if visible then
							local center =
								Vector2.new(
									cam.ViewportSize.X / 2,
									cam.ViewportSize.Y / 2
								)

							distance =
								(Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
						end
					end
				end

				if distance and distance < bestDistance then
					bestDistance = distance
					closestPlayer = plr
				end
			end
		end
	end

	return closestPlayer
end

local function countEnemies()
	local count = 0

	for _, plr in ipairs(Players:GetPlayers()) do
		if isEnemyPlayer(plr) then
			count = count + (1)
		end
	end

	return count
end

